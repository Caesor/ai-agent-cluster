        "secondary": "用于次要操作、装饰元素",
        "neutral": "用于文本、背景、边框",
        "transparent": "用于遮罩、浮层背景"
      },
      "typographyUsage": {
        "headers": "使用较大字号和适当字重建立信息层级",
        "body": "使用14px作为主要阅读字号，确保可读性",
        "ui": "界面元素使用系统字体栈，保持一致性"
      },
      "spacingUsage": {
        "component": "组件内部使用4px-8px的紧密间距",
        "layout": "布局使用16px-32px的宽松间距",
