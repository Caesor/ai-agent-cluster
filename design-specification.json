    "designPrinciples": {
      "colorPhilosophy": "以绿色为主色调，体现金融科技的专业性和可信度，绿色象征成长和财富",
      "typographyPhilosophy": "采用系统字体栈确保跨平台一致性，中文使用苹方字体提升阅读体验",
      "spacingPhilosophy": "基于8px网格系统，确保视觉节奏的一致性",
      "interactionPhilosophy": "简洁明了的交互设计，突出功能性和易用性",
      "accessibility": "确保足够的颜色对比度，支持键盘导航和屏幕阅读器"
    },
    "usage": {
